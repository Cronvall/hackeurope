# Chargetrip API credentials
# Get these from https://account.chargetrip.com/ → your project → Apps
#
# CHARGE_TRIP_PROJECT_ID is sent as the x-client-id header.
# It is the ID of the project (not the app), found on the project overview page.
#
# CHARGE_TRIP_APP_ID is sent as the x-app-id header.
# It is the ID of the specific app created under your project.

CHARGE_TRIP_PROJECT_ID=your_project_id_here
CHARGE_TRIP_APP_ID=your_app_id_here
